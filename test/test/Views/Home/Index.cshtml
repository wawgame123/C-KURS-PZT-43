@model test.Models.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Расписание";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="fw-bold">
            Расписание
        </h1>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#settingsPanel"
                    aria-expanded="false"
                    aria-controls="settingsPanel">
                Настройки
            </button>

        </div>

    </div>

    <div class="collapse mb-3"
         id="settingsPanel">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-xl-2 col-lg-3 col-md-4">
                        <label class="form-label">Тема</label>
                        <button class="btn btn-outline-secondary w-100"
                                id="themeToggle"
                                type="button">
                            Переключить
                        </button>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-4">
                        <label class="form-label">По умолчанию</label>
                        <select class="form-select"
                                id="defaultTargetMode">
                            <option value="student">Ученик</option>
                            <option value="teacher">Преподаватель</option>
                        </select>
                    </div>

                    <div class="col-xl-3 col-lg-6 col-md-6"
                         id="defaultGroupSettingContainer">
                        <label class="form-label">Группа по умолчанию</label>
                        <select class="form-select"
                                id="defaultGroupSetting">
                            <option value="">Не выбрано</option>
                            @foreach (var group in Model.Groups)
                            {
                                <option value="@group.Name">@group.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-xl-3 col-lg-6 col-md-6"
                         id="defaultTeacherSettingContainer">
                        <label class="form-label">Преподаватель по умолчанию</label>
                        <select class="form-select"
                                id="defaultTeacherSetting">
                            <option value="">Не выбрано</option>
                            @foreach (var teacher in Model.Teachers)
                            {
                                <option value="@teacher.FullName">@teacher.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-4">
                        <label class="form-label">Режим отображения</label>
                        <select class="form-select"
                                id="layoutModeSelect">
                            <option value="vertical">Вертикально</option>
                            <option value="horizontal">Горизонтально</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-lg-3 col-md-4"
                         id="cardSizeSettingContainer">
                        <label class="form-label">Размер карточек</label>
                        <select class="form-select"
                                id="cardSizeSelect">
                            <option value="min">Минимум</option>
                            <option value="max">Максимум</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-end">
                        <button class="btn btn-primary"
                                type="button"
                                id="saveSettingsBtn">
                            Сохранить настройки
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4 filter-card">

        <div class="card-body">

            <form method="post"
                  asp-action="Index"
                  id="filterForm">

                <button class="btn btn-outline-secondary w-100 d-md-none mb-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mobileFilters"
                        aria-expanded="false"
                        aria-controls="mobileFilters">
                    Фильтры
                </button>

                <div class="row g-3 collapse show"
                     id="mobileFilters">

                    <div class="col-xl-2 col-lg-3">

                        <label class="form-label">
                            Режим
                        </label>

                        <select class="form-select"
                                id="modeSelect"
                                name="Mode">

                            <option value="student"
                                    selected="@(Model.Filter.Mode == "student")">
                                Ученик
                            </option>

                            <option value="teacher"
                                    selected="@(Model.Filter.Mode == "teacher")">
                                Преподаватель
                            </option>

                        </select>

                    </div>

                    <div class="col-xl-3 col-lg-4"
                         id="departmentContainer">

                        <label class="form-label">
                            Отделение
                        </label>

                        <select class="form-select"
                                id="departmentSelect"
                                name="Department">

                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Key"
                                        selected="@(Model.Filter.Department == department.Key)">
                                    @test.Data.DepartmentData.DepartmentTitles[department.Key]
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-xl-3 col-lg-4"
                         id="groupCodeContainer">

                        <label class="form-label">
                            Направление
                        </label>

                        <select class="form-select"
                                id="groupCodeSelect"
                                name="GroupCode">
                        </select>

                    </div>

                    <div class="col-xl-3 col-lg-6"
                         id="groupContainer">

                        <label class="form-label">
                            Группа
                        </label>

                        <select class="form-select"
                                id="selectedGroupSelect"
                                name="SelectedGroup">

                            <option value="">
                                Все группы
                            </option>

                            @foreach (var group in Model.Groups)
                            {
                                <option value="@group.Name"
                                        selected="@(Model.Filter.SelectedGroup == group.Name)">
                                    @group.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-xl-3 col-lg-6"
                         id="teacherContainer">

                        <label class="form-label">
                            Преподаватель
                        </label>

                        <select class="form-select"
                                id="selectedTeacherSelect"
                                name="SelectedTeacher">

                            <option value="">
                                Все преподаватели
                            </option>

                            @foreach (var teacher in Model.Teachers)
                            {
                                <option value="@teacher.FullName"
                                        selected="@(Model.Filter.SelectedTeacher == teacher.FullName)">
                                    @teacher.FullName
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-xl-2 col-lg-3">

                        <label class="form-label">
                            &nbsp;
                        </label>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Применить
                        </button>

                    </div>
                    
                    <div class="col-12">
                        <div class="layout-hint mt-1"
                             id="layoutHint">
                            Горизонтальный вид доступен для преподавателя или выбранной группы.
                        </div>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="row">

        @foreach (var day in Model.ScheduleDays)
        {
            <div class="col-12 mb-4">

                <div class="card h-100 shadow-sm schedule-card">

                    <div class="card-header">

                        <div class="fw-bold fs-4">
                            @day.DayTitle
                        </div>

                    </div>

                    <div class="card-body">

                        @if (
                            string.IsNullOrWhiteSpace(Model.Filter.SelectedGroup) &&
                            Model.Filter.Mode == "student")
                        {
                            var groupedLessons = day.Lessons
                                .GroupBy(x => x.GroupName)
                                .OrderByDescending(x => x.Key);

                            <div class="groups-grid">

                                @foreach (var group in groupedLessons)
                                {
                                    <div class="group-column">

                                        <div class="group-title">
                                            @group.Key
                                        </div>

                                        @{
                                            var lessons =
                                                group
                                                .OrderBy(x => x.SortTime)
                                                .ThenBy(x => x.LessonNumber)
                                                .ToList();
                                        }

                                        @for (int i = 0; i < lessons.Count; i++)
                                        {
                                            var lesson = lessons[i];

                                            bool isLastOdd =
                                                lessons.Count % 2 != 0 &&
                                                i == lessons.Count - 1;

                                            <div class="lesson-wrapper @(isLastOdd ? "lesson-full" : "")">

                                                <div class="lesson-block mb-3">

                                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                        <div class="fw-bold lesson-num text-nowrap">
                                                            Пара @lesson.LessonNumber
                                                        </div>
                                                        <div class="lesson-time text-end  small">
                                                            @lesson.Time
                                                        </div>
                                                    </div>

                                                    <div class="subject-title lesson-subject">
                                                        @lesson.Subject
                                                    </div>

                                                    <div class="lesson-info lesson-teacher">
                                                        @lesson.Teacher
                                                    </div>

                                                    <div class="lesson-info lesson-room">
                                                        Кабинет: @lesson.Classroom
                                                    </div>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            var lessons =
                                day.Lessons
                                .OrderBy(x => x.SortTime)
                                .ThenBy(x => x.LessonNumber)
                                .ToList();

                            <div class="lesson-grid">

                                @for (int i = 0; i < lessons.Count; i++)
                                {
                                    var lesson = lessons[i];

                                    bool isLastOdd =
                                        lessons.Count % 2 != 0 &&
                                        i == lessons.Count - 1;

                                    <div class="@(isLastOdd ? "lesson-full" : "")">

                                        <div class="lesson-block h-100">

                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                <div class="fw-bold lesson-num text-nowrap">
                                                    Пара @lesson.LessonNumber
                                                </div>
                                                <div class="lesson-time text-end  small">
                                                    @lesson.Time
                                                </div>
                                            </div>

                                            <div class="subject-title lesson-subject">
                                                @lesson.Subject
                                            </div>

                                            <div class="lesson-info lesson-group">
                                                @lesson.GroupName
                                            </div>

                                            <div class="lesson-info lesson-teacher">
                                                @lesson.Teacher
                                            </div>

                                            <div class="lesson-info lesson-room">
                                                Кабинет: @lesson.Classroom
                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>

    const departments =
        @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.Departments));

    const titles =
    {
        TAR: 'ТОР',
        BSB: 'БСК',
        BDA: 'БДА',
        PGB: 'ПГБ',
        PZT: 'ПЗТ',
        AEP: 'АЭП',
        AGB: 'АГБ'
    };

    const departmentSelect =
        document.getElementById('departmentSelect');

    const groupCodeSelect =
        document.getElementById('groupCodeSelect');

    function updateGroups()
    {
        if (!departmentSelect || !groupCodeSelect)
        {
            return;
        }

        const previousSelectedGroup =
            groupCodeSelect.value;

        const selectedDepartment =
            departmentSelect.value;

        groupCodeSelect.innerHTML = '';

        const groups =
            departments[selectedDepartment];

        if (groups.length === 0)
        {
            const option =
                document.createElement('option');

            option.value = '';

            option.text = 'Без выбора';

            groupCodeSelect.appendChild(option);

            return;
        }

        groups.forEach(group =>
        {
            const option =
                document.createElement('option');

            option.value = group;

            option.text =
                titles[group] ?? group;

            if (group === previousSelectedGroup ||
                group === '@Model.Filter.GroupCode')
            {
                option.selected = true;
            }

            groupCodeSelect.appendChild(option);
        });

        if (groupCodeSelect.selectedIndex < 0 &&
            groupCodeSelect.options.length > 0)
        {
            groupCodeSelect.selectedIndex = 0;
        }
    }

    if (departmentSelect)
    {
        departmentSelect.addEventListener(
            'change',
            updateGroups);

        departmentSelect.addEventListener(
            'change',
            submitFilter);

        updateGroups();
    }

    const modeSelect =
        document.getElementById('modeSelect');

    const teacherContainer =
        document.getElementById('teacherContainer');

    const groupContainer =
        document.getElementById('groupContainer');

    const departmentContainer =
        document.getElementById('departmentContainer');

    const groupCodeContainer =
        document.getElementById('groupCodeContainer');

    function updateMode()
    {
        if (modeSelect.value === 'teacher')
        {
            teacherContainer.style.display = 'block';

            groupContainer.style.display = 'none';

            departmentContainer.style.display = 'none';

            groupCodeContainer.style.display = 'none';
        }
        else
        {
            teacherContainer.style.display = 'none';

            groupContainer.style.display = 'block';

            departmentContainer.style.display = 'block';

            groupCodeContainer.style.display = 'block';
        }
    }

    modeSelect.addEventListener(
        'change',
        updateMode);

    updateMode();

    const filterForm =
        document.getElementById('filterForm');

    function submitFilter()
    {
        if (!filterForm)
        {
            return;
        }

        filterForm.submit();
    }

    if (modeSelect)
    {
        modeSelect.addEventListener(
            'change',
            submitFilter);
    }

    if (groupCodeSelect)
    {
        groupCodeSelect.addEventListener(
            'change',
            submitFilter);
    }

    const layoutModeSelect =
        document.getElementById('layoutModeSelect');

    const selectedGroupSelect =
        document.getElementById('selectedGroupSelect');

    const selectedTeacherSelect =
        document.getElementById('selectedTeacherSelect');

    const layoutHint =
        document.getElementById('layoutHint');

    function applyLayout(layout)
    {
        document.body.classList.toggle(
            'horizontal-layout',
            layout === 'horizontal');
    }

    function hasSelectedGroup()
    {
        if (!selectedGroupSelect)
        {
            return false;
        }

        return selectedGroupSelect.value.trim() !== '';
    }

    function canUseHorizontalLayout()
    {
        if (modeSelect &&
            modeSelect.value === 'teacher')
        {
            return true;
        }

        return hasSelectedGroup();
    }

    function normalizeLayout(layout)
    {
        return layout === 'horizontal'
            ? 'horizontal'
            : 'vertical';
    }

    function syncCardSizeSettingVisibility(layout)
    {
        const cardSizeSettingContainer =
            document.getElementById('cardSizeSettingContainer');

        if (!cardSizeSettingContainer)
        {
            return;
        }

        cardSizeSettingContainer.style.display =
            layout === 'vertical'
                ? 'block'
                : 'none';
    }

    function syncLayoutControls(layout)
    {
        const requestedLayout =
            normalizeLayout(layout);

        const effectiveLayout =
            canUseHorizontalLayout()
                ? requestedLayout
                : 'vertical';

        if (layoutModeSelect)
        {
            layoutModeSelect.value = effectiveLayout;
        }

        applyLayout(effectiveLayout);

        syncCardSizeSettingVisibility(effectiveLayout);

        if (layoutHint)
        {
            layoutHint.style.display =
                canUseHorizontalLayout()
                    ? 'none'
                    : 'block';
        }

        return effectiveLayout;
    }

    if (layoutModeSelect)
    {
        const savedLayout =
            localStorage.getItem('scheduleLayout') ?? 'vertical';

        syncLayoutControls(savedLayout);

        layoutModeSelect.addEventListener('change', () =>
        {
            const requestedLayout =
                normalizeLayout(layoutModeSelect.value);

            const effectiveLayout =
                syncLayoutControls(requestedLayout);

            localStorage.setItem(
                'scheduleLayout',
                effectiveLayout);
        });
    }
    else
    {
        document.body.classList.remove('horizontal-layout');
    }

    const cardSizeSelect =
        document.getElementById('cardSizeSelect');

    const defaultTargetMode =
        document.getElementById('defaultTargetMode');

    const defaultGroupSetting =
        document.getElementById('defaultGroupSetting');

    const defaultTeacherSetting =
        document.getElementById('defaultTeacherSetting');

    const defaultGroupSettingContainer =
        document.getElementById('defaultGroupSettingContainer');

    const defaultTeacherSettingContainer =
        document.getElementById('defaultTeacherSettingContainer');

    const saveSettingsBtn =
        document.getElementById('saveSettingsBtn');

    function applyCardSize(size)
    {
        document.body.classList.remove(
            'card-size-min',
            'card-size-max');

        const normalized =
            size === 'min' || size === 'max'
                ? size
                : 'max';

        document.body.classList.add(
            `card-size-${normalized}`);
    }

    const savedCardSize =
        localStorage.getItem('scheduleCardSize') ?? 'max';

    applyCardSize(savedCardSize);

    if (cardSizeSelect)
    {
        cardSizeSelect.value = savedCardSize;

        cardSizeSelect.addEventListener('change', () =>
        {
            applyCardSize(cardSizeSelect.value);
        });
    }

    function normalizeDefaultTargetMode(mode)
    {
        return mode === 'teacher'
            ? 'teacher'
            : 'student';
    }

    function updateDefaultSettingVisibility()
    {
        if (!defaultTargetMode)
        {
            return;
        }

        const defaultMode =
            normalizeDefaultTargetMode(defaultTargetMode.value);

        if (defaultGroupSettingContainer)
        {
            defaultGroupSettingContainer.style.display =
                defaultMode === 'student'
                    ? 'block'
                    : 'none';
        }

        if (defaultTeacherSettingContainer)
        {
            defaultTeacherSettingContainer.style.display =
                defaultMode === 'teacher'
                    ? 'block'
                    : 'none';
        }
    }

    if (defaultTargetMode)
    {
        defaultTargetMode.value =
            normalizeDefaultTargetMode(
                localStorage.getItem('defaultTargetMode') ?? 'student');

        defaultTargetMode.addEventListener(
            'change',
            updateDefaultSettingVisibility);
    }

    if (defaultGroupSetting)
    {
        defaultGroupSetting.value =
            localStorage.getItem('defaultGroupValue') ?? '';
    }

    if (defaultTeacherSetting)
    {
        defaultTeacherSetting.value =
            localStorage.getItem('defaultTeacherValue') ?? '';
    }

    updateDefaultSettingVisibility();

    function applyDefaultSelectionOnce()
    {
        const markerKey = 'scheduleDefaultsApplied';

        if (sessionStorage.getItem(markerKey) === '1')
        {
            return;
        }

        if (!modeSelect)
        {
            return;
        }

        const modePref =
            normalizeDefaultTargetMode(
                localStorage.getItem('defaultTargetMode') ?? 'student');

        const defaultGroup =
            localStorage.getItem('defaultGroupValue') ?? '';

        const defaultTeacher =
            localStorage.getItem('defaultTeacherValue') ?? '';

        let changed = false;

        if (modePref === 'student' && defaultGroup && selectedGroupSelect)
        {
            if (modeSelect.value !== 'student')
            {
                modeSelect.value = 'student';
                changed = true;
            }

            if (selectedGroupSelect.value !== defaultGroup &&
                Array.from(selectedGroupSelect.options)
                    .some(x => x.value === defaultGroup))
            {
                selectedGroupSelect.value = defaultGroup;
                changed = true;
            }
        }

        if (modePref === 'teacher' &&
            defaultTeacher &&
            selectedTeacherSelect)
        {
            if (modeSelect.value !== 'teacher')
            {
                modeSelect.value = 'teacher';
                changed = true;
            }

            if (selectedTeacherSelect.value !== defaultTeacher &&
                Array.from(selectedTeacherSelect.options)
                    .some(x => x.value === defaultTeacher))
            {
                selectedTeacherSelect.value = defaultTeacher;
                changed = true;
            }
        }

        if (changed)
        {
            sessionStorage.setItem(markerKey, '1');
            updateMode();
            submitFilter();
        }
    }

    if (saveSettingsBtn)
    {
        saveSettingsBtn.addEventListener('click', () =>
        {
            if (cardSizeSelect)
            {
                const size =
                    cardSizeSelect.value === 'min'
                        ? 'min'
                        : 'max';

                localStorage.setItem(
                    'scheduleCardSize',
                    size);

                applyCardSize(size);
            }

            if (defaultTargetMode)
            {
                const defaultMode =
                    normalizeDefaultTargetMode(defaultTargetMode.value);

                localStorage.setItem(
                    'defaultTargetMode',
                    defaultMode);

                defaultTargetMode.value =
                    defaultMode;

                updateDefaultSettingVisibility();
            }

            if (defaultGroupSetting)
            {
                localStorage.setItem(
                    'defaultGroupValue',
                    defaultGroupSetting.value);
            }

            if (defaultTeacherSetting)
            {
                localStorage.setItem(
                    'defaultTeacherValue',
                    defaultTeacherSetting.value);
            }

            if (layoutModeSelect)
            {
                const effectiveLayout =
                    syncLayoutControls(layoutModeSelect.value);

                localStorage.setItem(
                    'scheduleLayout',
                    effectiveLayout);
            }
        });
    }

    applyDefaultSelectionOnce();

</script>
